{
  "name": "@lab/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "vitest run",
    "db:replset-init": "node --env-file-if-exists=../.env src/db/initReplicaSet.js",
    "db:check": "node --env-file-if-exists=../.env src/db/checkTransaction.js"
  },
  "dependencies": {
    "connect-mongo": "6.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mongoose": "9.11.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1"
  }
}
